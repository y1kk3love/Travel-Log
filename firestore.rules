rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 사이트 주인. 초대 목록(allowedUsers)은 이 계정만 관리한다.
    function isSiteOwner() {
      return request.auth != null && request.auth.uid == "cA5VgvDvMKQMVKtEDyggCGVqTvW2";
    }
    function signedIn() {
      return request.auth != null;
    }
    function myEmail() {
      return request.auth.token.email;
    }
    // 여행의 소유자이거나 동행 이메일 목록에 있으면 멤버
    function isMemberOf(data) {
      return signedIn() && (data.ownerUid == request.auth.uid || myEmail() in data.memberEmails);
    }
    function tripData(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)).data;
    }
    // 배치 쓰기로 여행과 하위 문서를 함께 만들 때는 쓰기 후 상태를 봐야 여행 문서가 보인다
    function tripDataAfter(tripId) {
      return getAfter(/databases/$(database)/documents/trips/$(tripId)).data;
    }
    // 초대받은 계정(allowedUsers 에 있음)이거나 사이트 주인
    function isInvited() {
      return isSiteOwner() || exists(/databases/$(database)/documents/allowedUsers/$(myEmail()));
    }
    // 프로필(닉네임·사진): 본인 것은 누구나, 남의 것은 초대받은 계정만 단건 조회. 목록 조회는 막는다.
    // (Google 계정만 있으면 누구나 로그인 자체는 되므로, 로그인만으로 모든 프로필을 긁어가지 못하게)
    match /profiles/{email} {
      allow get: if signedIn() && (email == myEmail() || isInvited());
      allow list: if false;
      allow write: if signedIn() && email == myEmail() && request.resource.data.uid == request.auth.uid;
    }

    // 새 여행을 만들 수 있는 계정: 사이트 주인이거나 초대 목록 항목에 canCreate 가 켜진 계정
    function canCreateTrips() {
      return isSiteOwner()
        || (signedIn() && exists(/databases/$(database)/documents/allowedUsers/$(myEmail()))
            && get(/databases/$(database)/documents/allowedUsers/$(myEmail())).data.get('canCreate', false) == true);
    }
    // 초대 목록: 본인 항목은 누구나, 전체 목록은 사이트 주인만 읽는다.
    // 쓰기: 사이트 주인은 전부. 여행을 만들 수 있는 계정은 동행 초대용으로 항목을 추가·갱신만 할 수 있고 canCreate 는 못 켠다.
    match /allowedUsers/{email} {
      allow get: if signedIn() && (email == myEmail() || isSiteOwner());
      allow list: if isSiteOwner();
      allow create: if isSiteOwner() || (canCreateTrips() && request.resource.data.get('canCreate', false) == false);
      allow update: if isSiteOwner() || (canCreateTrips() && request.resource.data.get('canCreate', false) == resource.data.get('canCreate', false));
      allow delete: if isSiteOwner();
    }

    match /trips/{tripId} {
      // 없는 여행(방금 삭제된 것 등)을 단건 조회하면 오류 대신 "없음"이 오도록 허용한다. 목록 조회는 멤버만.
      allow get: if signedIn() && (resource == null || isMemberOf(resource.data));
      allow list: if isMemberOf(resource.data);
      // 새 여행은 사이트 주인 또는 "여행 만들기"가 켜진 초대 계정이 만든다. 만든 사람이 그 여행의 주인.
      allow create: if canCreateTrips()
        && request.resource.data.ownerUid == request.auth.uid
        && myEmail() in request.resource.data.memberEmails;
      // 멤버는 내용을 고칠 수 있지만 소유자는 못 바꾸고, 동행 목록은 소유자만 바꾼다
      allow update: if isMemberOf(resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && (request.resource.data.memberEmails == resource.data.memberEmails || resource.data.ownerUid == request.auth.uid);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /{sub=**} {
        allow read, delete: if isMemberOf(tripData(tripId));
        allow create, update: if isMemberOf(tripDataAfter(tripId));
      }
    }
  }
}
